# Copy this file to server/.env and fill in real values. Never commit server/.env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=sk_test_replace_me
# Comma separated list of allowed frontend URLs
CLIENT_ORIGIN=http://localhost:3000
PORT=3001
# Optional: insert demo catalogue data into an empty database at startup
SEED_DEMO=false
# Optional: also create demo customer, seller and admin accounts with this password
SEED_DEMO_PASSWORD=
